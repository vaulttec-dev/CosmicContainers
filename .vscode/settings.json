{
  "devManager.project.packageManager": "auto",
  "devManager.project.servers": [
    {
      "id": "rust",
      "label": "Rust binary",
      "command": "cargo run --release",
      "path": "",
      "port": 0
    }
  ],
  "devManager.quality.profile": "strict",
  "devManager.quality.degradedStrict": true,
  "devManager.quality.customChecks": [
    {
      "id": "cargo-fmt",
      "label": "cargo fmt",
      "command": "cargo fmt --check"
    },
    {
      "id": "cargo-verify",
      "label": "cargo verify",
      "command": "bash scripts/cargo-precommit.sh"
    },
    {
      "id": "cargo-clippy",
      "label": "cargo clippy",
      "command": "cargo clippy --all-features --locked -- -D warnings"
    },
    {
      "id": "cargo-audit",
      "label": "cargo audit",
      "command": "cargo audit"
    }
  ],
  "devManager.quality.skipDirs": [
    "target",
    "build-dir",
    ".flatpak-builder",
    "flatpak-build",
    "cosmic-repo-test",
    "build-cosmic",
    "build-cosmic-git",
    "cosmic-build-log",
    "repo"
  ],
  "devManager.git.defaultBranch": "master",
  "devManager.ci.workflowsPath": ".github/workflows",
  "devManager.workflows.custom": [
    {
      "id": "install-local",
      "label": "Install locally",
      "icon": "desktop-download",
      "stopOnFailure": true,
      "steps": [
        {
          "kind": "shell",
          "command": "bash scripts/install-local.sh"
        }
      ]
    },
    {
      "id": "flatpak-lint",
      "label": "Flatpak: lint manifest",
      "icon": "checklist",
      "stopOnFailure": true,
      "steps": [
        {
          "kind": "shell",
          "command": "bash scripts/flatpak-lint.sh"
        }
      ]
    },
    {
      "id": "flatpak-build",
      "label": "Flatpak: build and install (local)",
      "icon": "package",
      "stopOnFailure": true,
      "steps": [
        {
          "kind": "shell",
          "command": "bash scripts/flatpak-build-local.sh"
        }
      ]
    },
    {
      "id": "release-check",
      "label": "Release check (Rust / CI parity)",
      "icon": "rocket",
      "stopOnFailure": true,
      "steps": [
        {
          "kind": "shell",
          "command": "bash scripts/release-check.sh"
        }
      ]
    }
  ],
  "devManager.realtime.enabled": false,
  "devManager.realtime.precommit.mode": "block",
  "devManager.realtime.precommit.sendFailToChat": true,
  "devManager.realtime.precommit.customChecks": [
    {
      "id": "cargo-fmt",
      "label": "cargo fmt",
      "kind": "command",
      "command": "cargo fmt --check",
      "severity": "error"
    },
    {
      "id": "cargo-verify",
      "label": "cargo verify",
      "kind": "command",
      "command": "bash scripts/cargo-precommit.sh",
      "severity": "error"
    },
    {
      "id": "cargo-clippy",
      "label": "cargo clippy",
      "kind": "command",
      "command": "cargo clippy --all-features --locked -- -D warnings",
      "severity": "error"
    },
    {
      "id": "cargo-audit",
      "label": "cargo audit",
      "kind": "command",
      "command": "cargo audit",
      "severity": "error"
    },
    {
      "id": "no-todo-rust",
      "label": "No TODO/FIXME in staged Rust",
      "kind": "pattern",
      "pattern": "TODO|FIXME|XXX|HACK|UNSAFE",
      "filePattern": "src/**/*.rs",
      "scope": "diff",
      "severity": "warn"
    },
    {
      "id": "no-debug-print",
      "label": "No dbg!/todo! in staged Rust",
      "kind": "pattern",
      "pattern": "dbg!\\(|todo!\\(|unimplemented!\\(",
      "filePattern": "src/**/*.rs",
      "scope": "diff",
      "severity": "error"
    }
  ],
  "devManager.quality.builtin.cargoToml.enabled": true,
  "devManager.quality.builtin.cargoToml.precommit": true,
  "devManager.quality.builtin.lockfileSync.enabled": true,
  "devManager.quality.builtin.lockfileSync.precommit": true,
  "devManager.quality.builtin.secretLeaks.enabled": true,
  "devManager.quality.builtin.secretLeaks.precommit": true,
  "devManager.quality.builtin.gitignoreCheck.enabled": true,
  "devManager.quality.builtin.gitignoreCheck.precommit": true,
  "devManager.quality.builtin.debugLeaks.enabled": true,
  "devManager.quality.builtin.debugLeaks.precommit": true,
  "devManager.quality.builtin.trojanSource.enabled": true,
  "devManager.quality.builtin.trojanSource.precommit": true,
  "devManager.quality.builtin.shellcheck.enabled": true,
  "devManager.quality.builtin.shellcheck.precommit": true,
  "devManager.quality.builtin.commentedCode.enabled": true,
  "devManager.quality.builtin.commentedCode.precommit": true,
  "devManager.quality.builtin.testRatio.warnAt": 0,
  "devManager.quality.builtin.stryker.enabled": false,
  "devManager.quality.builtin.act.enabled": false,
  "devManager.quality.builtin.alex.enabled": false,
  "devManager.quality.builtin.pkgAudit.enabled": false,
  "devManager.quality.builtin.scorecard.enabled": false,
  "devManager.quality.builtin.trivy.enabled": false,
  "devManager.quality.semgrep.config": "auto",
  "devManager.team.enabled": false,
  "devManager.quality.builtin.reactHookRules.enabled": false,
  "devManager.quality.builtin.a11yCheck.enabled": false,
  "devManager.quality.builtin.eslint.enabled": false,
  "devManager.quality.builtin.prettierCheck.enabled": false
}
