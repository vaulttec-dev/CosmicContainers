{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install locally",
      "type": "shell",
      "command": "./scripts/install-local.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Rust binary",
      "type": "shell",
      "command": "cargo run --release",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "problemMatcher": []
    }
  ]
}
