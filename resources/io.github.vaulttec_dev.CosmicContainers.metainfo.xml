  <name>Cosmic Containers</name>
  <summary>Docker container manager for the COSMIC panel</summary>
  <description>
    <p>Panel applet for Pop!_OS COSMIC: shows how many Docker containers are running, lists all containers in a popup, and lets you start or stop them without a terminal.</p>
    <p>Requires the Docker CLI and a running Docker daemon on the host.</p>
  </description>
  <launchable type="desktop-id">io.github.vaulttec_dev.CosmicContainers.desktop</launchable>
  <icon type="stock">io.github.vaulttec_dev.CosmicContainers</icon>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/vaulttec-dev/CosmicContainers/master/resources/screenshots/popup-containers.png</image>
      <caption>Containers grouped by Compose project, with published ports and start, restart, and delete actions</caption>
    </screenshot>
  </screenshots>
  <url type="homepage">https://github.com/vaulttec-dev/CosmicContainers</url>
  <url type="bugtracker">https://github.com/vaulttec-dev/CosmicContainers/issues</url>
