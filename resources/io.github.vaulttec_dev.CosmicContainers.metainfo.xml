  <name>Cosmic Containers</name>
  <summary>Docker container manager for the COSMIC panel</summary>
  <description>
    <p>Panel applet for Pop!_OS COSMIC: shows how many Docker containers are running, lists all containers in a popup, and lets you start or stop them without a terminal.</p>
    <p>Requires the Docker CLI and a running Docker daemon on the host.</p>
  </description>
  <launchable type="desktop-id">io.github.vaulttec_dev.CosmicContainers.desktop</launchable>
  <icon type="stock">io.github.vaulttec_dev.CosmicContainers</icon>
  <url type="homepage">https://github.com/vaulttec-dev/linux-pop-extension</url>
  <url type="bugtracker">https://github.com/vaulttec-dev/linux-pop-extension/issues</url>
  <url type="vcs-browser">https://github.com/vaulttec-dev/linux-pop-extension</url>
  <provides>
    <binary>linux-pop-extension</binary>
  </provides>
  <categories>
    <category>COSMIC</category>
    <category>Development</category>
  </categories>
  <keywords>
    <keyword>COSMIC</keyword>
    <keyword>applet</keyword>
    <keyword>Docker</keyword>
    <keyword>containers</keyword>
  </keywords>
  <releases>
    <release version="0.1.0" date="2026-05-23">
      <description>
        <p>Initial release: manage Docker containers, images, and volumes from the COSMIC panel.</p>
      </description>
