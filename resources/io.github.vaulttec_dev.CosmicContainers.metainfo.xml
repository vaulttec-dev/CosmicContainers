  <releases>
    <release version="0.2.0" date="2026-07-25">
      <url type="details">https://github.com/vaulttec-dev/CosmicContainers/releases/tag/v0.2.0</url>
      <description>
        <p>Adds a per-tab clean action, published ports and live CPU/RAM usage per container, and a larger popup. Fixes settings not persisting inside Flatpak and the panel count being clipped.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-05-23">
      <url type="details">https://github.com/vaulttec-dev/CosmicContainers/releases/tag/v0.1.0</url>
      <description>
        <p>Initial release: manage Docker containers, images, and volumes from the COSMIC panel.</p>
      </description>
    </release>
